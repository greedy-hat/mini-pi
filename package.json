{
  "name": "mini-pi",
  "version": "0.1.0",
  "private": true,
  "description": "A small TypeScript coding agent built from scratch.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mini-pi": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "prepare": "npm run build",
    "start": "node --env-file=.env dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
